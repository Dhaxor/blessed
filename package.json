{
  "name": "blessed-revived",
  "description": "A high-level terminal interface library for node.js. Community revival of the classic 'blessed' package (dormant since 2015) with fixes for modern Node.js, an automated test suite, and CI.",
  "author": "Christopher Jeffrey",
  "version": "0.2.0",
  "license": "MIT",
  "main": "./lib/blessed.js",
  "bin": "./bin/tput.js",
  "preferGlobal": false,
  "repository": {
    "type": "git",
    "url": "git://github.com/Dhaxor/blessed.git"
  },
  "homepage": "https://github.com/Dhaxor/blessed",
  "bugs": { "url": "http://github.com/Dhaxor/blessed/issues" },
  "keywords": ["curses", "tui", "tput", "terminfo", "termcap"],
  "tags": ["curses", "tui", "tput", "terminfo", "termcap"],
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "browser/",
    "usr/",
    "vendor/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/smoke.test.js test/node-tree.test.js test/keys.test.js"
  },
  "engines": {
    "node": ">= 12"
  },
  "browserify": {
    "transform": ["./browser/transform.js"]
  }
}
